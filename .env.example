# cp .env.example .env

# 多个 key 用逗号分隔（如 ms-aaa,ms-bbb）；余额不足（insufficient balance）
# 会自动切下一个 key 重投，切换不占 TRANSLATE_MAX_RETRIES 次数
API_KEY=ms-xxxxxxxx,ms-yyyyyyyy
MODEL=deepseek-ai/DeepSeek-V4.1-Flash

PROXY=http://127.0.0.1:7890
VOICE=zh-CN-YunyangNeural
QUALITY=720
WORKDIR=./work

# parakeet-mlx 本地 ASR（Apple Silicon；pip install parakeet-mlx 到 conda python3）
PARAKEET_MODEL=mlx-community/parakeet-tdt-0.6b-v3
# 句间静音分割阈值（秒）：
PARAKEET_SILENCE_GAP=2.0
# 长音频分块转录（0 关闭分块）
PARAKEET_CHUNK_DURATION=120
PARAKEET_OVERLAP_DURATION=15
# 解码方式：greedy / beam
PARAKEET_DECODING=greedy
PARAKEET_BEAM_SIZE=5
# 成品导出目录（可选）。成片仍留在 work/<id>/out.mp4，并复制/硬链到这里：
#   <中文标题> [<youtube_id>].mp4
# OUTPUT_DIR=./output

# 翻译稳定性
TRANSLATE_BATCH_SIZE=100
TRANSLATE_MAX_RETRIES=5
# 主翻译 batch 并发（默认 2；补译仍在全部主翻结束后串行）
TRANSLATE_CONCURRENCY=2
# 主翻结束后补译轮数上限（默认 2；某轮零进展会提前停）
TRANSLATE_REFILL_MAX_ROUNDS=2

# TTS：并发数（edge 易限流，默认 2；可调到 8~16）
TTS_CONCURRENCY=2
# TTS 最大加速百分比（0~100，默认 30）
TTS_MAX_RATE=30
# 单次 edge-tts 超时秒数（超时会再试 1 次，仍失败则该句缺音频，tts 阶段失败）
TTS_TIMEOUT=45

# 日志目录（按天切分：logs/2026-09-26.log）。屏幕只打阶段进度，详情进这里。
LOG_DIR=./logs

# 最终成片片头封面（可选；相对项目根或绝对路径；不配则不加）
# COVER_IMAGE=./assets/cover.png

# 可选工具绝对路径（配置了就严格使用）
# PYTHON=/Users/you/miniconda3/envs/python3/bin/python
# YT_DLP=/opt/homebrew/bin/yt-dlp
# FFMPEG=/opt/homebrew/bin/ffmpeg
# FFPROBE=/opt/homebrew/bin/ffprobe
# MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1
